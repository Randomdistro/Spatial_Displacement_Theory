// Function to generate static paths for all benchmarks
export async function getStaticPaths() {
  return Object.keys(benchmarkData).map(id => ({
    params: { id },
  }));
}

// Get the benchmark data for this page
const { id } = Astro.params;
const benchmark = benchmarkData[id!];

if (!benchmark) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${benchmark.name} (${benchmark.id}) - SDT Benchmark`}>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class={`px-3 py-1 rounded-full text-sm font-semibold text-white ${
            benchmark.status === 'certified' ? 'bg-emerald-500' :
            benchmark.status === 'investigation' ? 'bg-amber-500' :
            'bg-slate-400'
          }`}>
            {benchmark.status.charAt(0).toUpperCase() + benchmark.status.slice(1)}
          </span>
          <span class="text-sm text-slate-500">{benchmark.category}</span>
        </div>

        <h1 class="text-4xl font-bold text-slate-900 mb-2">
          {benchmark.id}: {benchmark.name}
        </h1>

        <p class="text-xl text-slate-600 mb-4">{benchmark.summary}</p>

        {benchmark.error && (
          <div class="flex items-center gap-2 text-lg">
            <span class="text-slate-600">Error margin:</span>
            <span class="font-mono font-bold text-emerald-600">{benchmark.error}</span>
          </div>
        )}
      </div>

      <!-- Main content -->
      <div class="grid gap-8">
        <!-- Physics explanation -->
        <section class="bg-white rounded-xl shadow-md p-8 border-l-4 border-blue-500">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">Physics Principle</h2>
          <p class="text-slate-700 leading-relaxed mb-4">{benchmark.physics}</p>
          {benchmark.formula && (
            <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm border border-slate-200">
              <code class="text-slate-900">{benchmark.formula}</code>
            </div>
          )}
        </section>

        <!-- Predictions -->
        <section class="bg-white rounded-xl shadow-md p-8 border-l-4 border-purple-500">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">Predictions & Observations</h2>
          <ul class="space-y-2">
            {benchmark.predictions.map((pred: string) => (
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold">✓</span>
                <span class="text-slate-700">{pred}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Validation data table -->
        <section class="bg-white rounded-xl shadow-md p-8 border-l-4 border-emerald-500">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">Validation Data</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-slate-300">
                  <th class="text-left py-2 px-3 font-semibold text-slate-700">System</th>
                  <th class="text-left py-2 px-3 font-semibold text-slate-700">Predicted</th>
                  <th class="text-left py-2 px-3 font-semibold text-slate-700">Measured</th>
                  <th class="text-left py-2 px-3 font-semibold text-slate-700">Error</th>
                </tr>
              </thead>
              <tbody>
                {benchmark.validationData.map((row: any) => (
                  <tr class="border-b border-slate-200 hover:bg-slate-50">
                    <td class="py-2 px-3 text-slate-900 font-medium">{row.system}</td>
                    <td class="py-2 px-3 text-slate-600 font-mono">{row.predicted}</td>
                    <td class="py-2 px-3 text-slate-600 font-mono">{row.measured}</td>
                    <td class={`py-2 px-3 font-mono font-semibold ${
                      row.error.includes('(') ? 'text-amber-600' : 'text-emerald-600'
                    }`}>
                      {row.error}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Implications -->
        <section class="bg-white rounded-xl shadow-md p-8 border-l-4 border-orange-500">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">Implications</h2>
          <p class="text-slate-700 leading-relaxed">{benchmark.implications}</p>
        </section>

        <!-- References -->
        <section class="bg-slate-50 rounded-xl p-8 border border-slate-200">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Source Materials</h2>
          <ul class="space-y-2">
            {benchmark.references.map((ref: string) => (
              <li class="text-slate-700">
                <a href={`/papers/${ref}`} class="text-blue-600 hover:underline font-mono text-sm">
                  {ref}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Navigation -->
        <div class="flex gap-4 justify-between pt-4">
          <a href="/benchmarks" class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-900 rounded-lg font-semibold transition-colors">
            ← Back to benchmarks
          </a>
          <a href="/papers" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors">
            View all papers →
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
