      "gamow_integral": {
        "formula": "G = (2/ℏ)∫_{R}^{r_c} √(2m_alpha[V(r) - E]) dr",
        "for_coulomb": "G = 2πη - 2arccos(√(R/r_c)) × √(R r_c) × (2m_alpha Z₁Z₂e²/ℏ²)^(1/2)",
        "sommerfeld_parameter": "η = Z₁Z₂e²/(4πε₀ℏv)"
      },
      "decay_rate": {
