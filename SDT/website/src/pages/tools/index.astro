---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Interactive Tools" description="SDT calculators and visualizations - test the theory with real data">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <h1 class="text-4xl font-display font-bold text-slate-900 mb-4">
        Interactive Tools
      </h1>
      <p class="text-xl text-slate-600">
        Test SDT predictions yourself. These calculators use the same equations from the theory
        papers&mdash;no black boxes, no fitting parameters.
      </p>
    </div>

    <!-- Calculator Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Orbital Calculator -->
      <a href="/tools/orbital-calculator" class="card group hover:shadow-xl transition-shadow">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-xl bg-sdt-primary-100 flex items-center justify-center flex-shrink-0 group-hover:bg-sdt-primary-200 transition-colors">
            <svg class="w-7 h-7 text-sdt-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <div>
            <h3 class="font-display font-semibold text-xl mb-2 group-hover:text-sdt-primary-600">
              Universal Orbital Calculator
            </h3>
            <p class="text-slate-600 mb-3">
              Test the k-law: v(r) = (c/k)&radic;(R/r) from atoms to galaxies.
              Compare SDT predictions with observed velocities.
            </p>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full">Live</span>
              <span class="text-sdt-primary-600 text-sm font-medium">Try it &rarr;</span>
            </div>
          </div>
        </div>
      </a>

      <!-- Stellar Calculator -->
      <div class="card opacity-75">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-xl bg-sdt-gold-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-sdt-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <div>
            <h3 class="font-display font-semibold text-xl mb-2">
              Stellar Parameter Calculator
            </h3>
            <p class="text-slate-600 mb-3">
              Predict stellar mass, surface gravity, and k-value from luminosity alone.
              Validate against Gaia/Kepler catalogs.
            </p>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full">Coming Soon</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Atomic Spectra Calculator -->
      <div class="card opacity-75">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-xl bg-purple-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-display font-semibold text-xl mb-2">
              Atomic Spectra Calculator
            </h3>
            <p class="text-slate-600 mb-3">
              Predict spectral lines for any element (H through Kr). Includes fine
              and hyperfine corrections. Compare with NIST database.
            </p>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full">Coming Soon</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Occlusion Simulator -->
      <div class="card opacity-75">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-display font-semibold text-xl mb-2">
              Occlusion Simulator
            </h3>
            <p class="text-slate-600 mb-3">
              Visualize the E(x,n&#770;) directional occlusion function. See how
              mutual shadowing creates forces between bodies.
            </p>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full">Coming Soon</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Visualizations Section -->
    <h2 class="text-2xl font-display font-bold text-slate-900 mb-6">
      Visualizations
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Alpha Tori -->
      <a href="/visualizations/alpha-tori" class="card group hover:shadow-lg transition-shadow">
        <div class="aspect-video bg-slate-900 rounded-lg mb-4 flex items-center justify-center overflow-hidden">
          <div class="text-sdt-gold-400 text-4xl animate-pulse">&infin;</div>
        </div>
        <h3 class="font-display font-semibold mb-2 group-hover:text-sdt-primary-600">
          Toroidal Electron Model
        </h3>
        <p class="text-slate-600 text-sm">
          Interactive 3D visualization of electron as a toroidal vortex with helical wake.
        </p>
      </a>

      <!-- Void Engine -->
      <a href="/visualizations/void-engine" class="card group hover:shadow-lg transition-shadow">
        <div class="aspect-video bg-gradient-to-br from-sdt-primary-900 to-slate-900 rounded-lg mb-4 flex items-center justify-center overflow-hidden">
          <div class="grid grid-cols-8 gap-0.5 opacity-30">
            {Array.from({length: 64}).map((_, i) => (
              <div class="w-2 h-2 bg-sdt-primary-400 rounded-full"></div>
            ))}
          </div>
        </div>
        <h3 class="font-display font-semibold mb-2 group-hover:text-sdt-primary-600">
          Spation Medium Animation
        </h3>
        <p class="text-slate-600 text-sm">
          See how the incompressible spation lattice responds to matter displacement.
        </p>
      </a>

      <!-- Pressure Cascade -->
      <a href="/visualizations/pressure-cascade" class="card group hover:shadow-lg transition-shadow">
        <div class="aspect-video bg-gradient-to-t from-sdt-gold-100 to-white rounded-lg mb-4 flex items-center justify-center overflow-hidden">
          <svg class="w-16 h-16 text-sdt-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" />
          </svg>
        </div>
        <h3 class="font-display font-semibold mb-2 group-hover:text-sdt-primary-600">
          Pressure Field Derivation
        </h3>
        <p class="text-slate-600 text-sm">
          Step-by-step visualization of how pressure gradients create gravitational force.
        </p>
      </a>
    </div>

    <!-- API Section -->
    <div class="bg-slate-900 rounded-xl p-8 text-white">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-display font-bold mb-4">
          For Developers: REST API
        </h2>
        <p class="text-slate-300 mb-6">
          Integrate SDT calculations into your own applications. All calculations are
          documented and reproducible.
        </p>
        <div class="bg-slate-800 rounded-lg p-4 font-mono text-sm text-slate-300 mb-4">
          <span class="text-green-400">GET</span> /api/v1/calculate/orbital?k=137&R=5.29e-11&r=5.29e-11
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs px-2 py-1 bg-yellow-600 text-yellow-100 rounded-full">Coming Soon</span>
          <span class="text-slate-400 text-sm">API documentation in development</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
