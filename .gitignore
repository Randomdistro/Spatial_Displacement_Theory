# =============================================================================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.synctex(busy)
*.toc
*.out
*.run.xml
*-blx.bib

# =============================================================================
# Data Files (Optional - uncomment to ignore large data files)
# =============================================================================
# *.csv
# *.json
# *.parquet
# *.hdf5
# *.h5

# =============================================================================
# Project-Specific Ignores
# =============================================================================
# Claude/AI session files
.claude/

# Investigation run logs
hodge_run.log
*/hodge_run.log

# Large binary outputs from simulations
*.vtk
*.vtu
*.pvd

# Generated images (keep source, ignore generated)
# Uncomment if needed:
# *.png
# *.jpg
# *.gif

# =============================================================================
# Keep These Files (negative patterns)
# =============================================================================
# Keep specific config files in subdirectories
!**/.clangd
!**/c_cpp_properties.json
