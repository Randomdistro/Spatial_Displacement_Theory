---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Theory" description="Explore Spatial Displacement Theory - from foundational axioms to specific applications in atomic physics, gravitation, and cosmology.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <h1 class="text-4xl font-display font-bold text-slate-900 mb-4">
        Theory Portal
      </h1>
      <p class="text-xl text-slate-600">
        Explore SDT from foundational axioms through specific applications.
        Each section builds systematically from first principles.
      </p>
    </div>

    <!-- Quick Start -->
    <div class="mb-12 p-6 bg-sdt-primary-50 rounded-xl border border-sdt-primary-200">
      <h2 class="font-display font-semibold text-xl text-sdt-primary-900 mb-3">
        New to SDT? Start Here
      </h2>
      <p class="text-sdt-primary-700 mb-4">
        Read the 5-minute overview to understand the core concepts before diving into detailed derivations.
      </p>
      <a href="/theory/overview" class="btn-primary inline-flex">
        Read Overview
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <!-- Main Categories -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      <!-- Foundations -->
      <a href="/theory/foundations" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-sdt-primary-100 flex items-center justify-center group-hover:bg-sdt-primary-200 transition-colors">
          <svg class="w-6 h-6 text-sdt-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Foundations
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          Core axioms, master equation, and the spation medium. Where everything begins.
        </p>
        <span class="text-sdt-primary-600 text-sm font-medium">Explore &rarr;</span>
      </a>

      <!-- Atomic Physics -->
      <a href="/theory/atomic-physics" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-purple-100 flex items-center justify-center group-hover:bg-purple-200 transition-colors">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Atomic Physics
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          Hydrogen spectrum, fine structure, multi-electron atoms. QED-level precision.
        </p>
        <div class="flex items-center gap-2">
          <span class="badge-certified text-xs">5 Certified</span>
          <span class="text-sdt-primary-600 text-sm font-medium">Explore &rarr;</span>
        </div>
      </a>

      <!-- Electromagnetism -->
      <a href="/theory/electromagnetism" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-yellow-100 flex items-center justify-center group-hover:bg-yellow-200 transition-colors">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Electromagnetism
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          Coulomb force, magnetic moments, E&M from pressure deformation.
        </p>
        <span class="text-sdt-primary-600 text-sm font-medium">Explore &rarr;</span>
      </a>

      <!-- Gravitation -->
      <a href="/theory/gravitation" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition-colors">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Gravitation
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          Gravity without G or M. Planetary orbits, stellar structure, GR tests.
        </p>
        <div class="flex items-center gap-2">
          <span class="badge-certified text-xs">4 Certified</span>
          <span class="text-sdt-primary-600 text-sm font-medium">Explore &rarr;</span>
        </div>
      </a>

      <!-- Cosmology -->
      <a href="/theory/cosmology" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-indigo-100 flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Cosmology
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          CMB as pressure horizon, galactic rotation without dark matter, BAO scale.
        </p>
        <div class="flex items-center gap-2">
          <span class="badge-certified text-xs">3 Certified</span>
          <span class="badge-investigation text-xs">1 Active</span>
        </div>
      </a>

      <!-- Nuclear Physics -->
      <a href="/theory/nuclear" class="card group hover:border-sdt-primary-300 border-2 border-transparent">
        <div class="w-12 h-12 mb-4 rounded-lg bg-red-100 flex items-center justify-center group-hover:bg-red-200 transition-colors">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2 text-slate-900 group-hover:text-sdt-primary-600">
          Nuclear Physics
        </h3>
        <p class="text-slate-600 text-sm mb-3">
          Toroidal protons, alpha architecture, superluminal binding. Speculative frontier.
        </p>
        <span class="badge-investigation text-xs">Under Development</span>
      </a>
    </div>

    <!-- Predictions Section -->
    <div class="mb-12">
      <h2 class="text-2xl font-display font-bold text-slate-900 mb-6">
        Falsifiable Predictions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-slate-50 rounded-xl">
          <h3 class="font-display font-semibold text-lg mb-3">No Dark Matter Required</h3>
          <p class="text-slate-600 text-sm mb-4">
            Flat galactic rotation curves arise from disk eclipse saturation.
            R<sub>flat</sub> should correlate with disk scale length as R<sub>flat</sub> &asymp; 2.5 R<sub>d</sub>.
          </p>
          <a href="/theory/predictions/dark-matter" class="text-sdt-primary-600 text-sm font-medium hover:underline">
            Learn more &rarr;
          </a>
        </div>

        <div class="p-6 bg-slate-50 rounded-xl">
          <h3 class="font-display font-semibold text-lg mb-3">CMB is Not Primordial</h3>
          <p class="text-slate-600 text-sm mb-4">
            The Cosmic Microwave Background represents a structural pressure horizon,
            not a surface of last scattering from 13.8 billion years ago.
          </p>
          <a href="/theory/predictions/cmb" class="text-sdt-primary-600 text-sm font-medium hover:underline">
            Learn more &rarr;
          </a>
        </div>

        <div class="p-6 bg-slate-50 rounded-xl">
          <h3 class="font-display font-semibold text-lg mb-3">Superluminal Nuclear Velocities</h3>
          <p class="text-slate-600 text-sm mb-4">
            Bound protons in nuclei orbit at v > c (10-100x faster than light).
            c is the EM propagation limit, not a mechanical speed limit.
          </p>
          <a href="/theory/predictions/superluminal" class="text-sdt-primary-600 text-sm font-medium hover:underline">
            Learn more &rarr;
          </a>
        </div>

        <div class="p-6 bg-slate-50 rounded-xl">
          <h3 class="font-display font-semibold text-lg mb-3">Emergent Fine Structure Constant</h3>
          <p class="text-slate-600 text-sm mb-4">
            &alpha; = 1/137.036 emerges from electron toroid geometry.
            High-precision measurements in strong fields might reveal variation.
          </p>
          <a href="/theory/predictions/alpha" class="text-sdt-primary-600 text-sm font-medium hover:underline">
            Learn more &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Complete Treatise CTA -->
    <div class="p-8 bg-gradient-to-br from-sdt-primary-600 to-sdt-primary-800 rounded-xl text-white text-center">
      <h2 class="text-2xl font-display font-bold mb-4">
        Want the Complete Picture?
      </h2>
      <p class="text-sdt-primary-100 mb-6 max-w-2xl mx-auto">
        "De Rerum Todo Existens" is the comprehensive 410KB treatise containing all derivations,
        proofs, and benchmark validations in systematic order.
      </p>
      <a href="/papers/de-rerum" class="btn-gold">
        Read Complete Treatise
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
