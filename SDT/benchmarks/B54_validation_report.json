        "R_nucleus": "R ≈ r₀ A^(1/3) ≈ 7 fm for heavy nuclei",
        "collision_rate": "ν ≈ 10²¹ Hz"
      },
      "coulomb_barrier": {
        "height": "V_barrier = Z₁Z₂e²/(4πε₀r) ≈ 30 MeV at nuclear surface",
        "alpha_energy": "E_alpha ≈ 4-9 MeV (emerges with this energy)",
        "barrier_width": "From R_nucleus to r_classical = Z₁Z₂e²/(4πε₀E)"
