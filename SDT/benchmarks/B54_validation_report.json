    "step_1_barrier_as_pressure_excess": {
      "title": "Barrier Definition in SDT",
      "classical_barrier": "Region where V(x) > E (potential exceeds particle energy)",
      "sdt_interpretation": {
        "pressure_barrier": "Region where local spation pressure exceeds particle's propagation threshold",
        "mathematically": "P_spation(x) > P_threshold(E)",
        "equivalence": "V(x) - E ↔ P_barrier(x)"
      }
    },

    "step_2_wave_equation_in_barrier": {
      "title": "Spation Wave Becomes Evanescent",
      "outside_barrier": {
        "wave_equation": "d²ψ/dx² + k²ψ = 0 where k = √(2mE)/ℏ",
        "solution": "ψ = A exp(ikx) + B exp(-ikx) (oscillating)"
      },
      "inside_barrier": {
        "wave_equation": "d²ψ/dx² - κ²ψ = 0 where κ = √(2m(V-E))/ℏ",
        "solution": "ψ = C exp(-κx) + D exp(κx) (exponential)",
        "physical_meaning": "Wave amplitude decays exponentially in barrier"
      },
      "sdt_interpretation": {
        "evanescent_wave": "Spation wave cannot sustain oscillation against pressure excess",
        "amplitude_decay": "Real physical damping, not probability amplitude"
      }
    },

    "step_3_transmission_coefficient": {
      "title": "Deriving Tunneling Probability",
      "boundary_conditions": {
        "at_x_0": "ψ and dψ/dx continuous",
        "at_x_d": "ψ and dψ/dx continuous"
      },
      "for_rectangular_barrier": {
        "transmission": "T = |t|² where t = transmitted amplitude",
        "exact_formula": "T = [1 + (k² + κ²)²sinh²(κd)/(4k²κ²)]⁻¹",
        "thick_barrier_limit": "For κd >> 1: T ≈ 16k²κ²/(k² + κ²)² × exp(-2κd)"
      },
      "wkb_approximation": {
        "for_general_barrier": "T ≈ exp(-2∫₀^d κ(x) dx)",
        "where": "κ(x) = √(2m[V(x) - E])/ℏ"
      }
    },

