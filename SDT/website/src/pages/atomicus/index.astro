---
// ATOMICUS - Interactive Periodic Table & Element Library
// Main entry point for the 118-element library

import BaseLayout from '../../layouts/BaseLayout.astro';
import AtomicusPeriodicTable from '../../components/AtomicusPeriodicTable';
---

<BaseLayout title="ATOMICUS - Periodic Table | SDT">
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold text-slate-900 mb-4">ATOMICUS</h1>
        <p class="text-2xl text-slate-600 mb-4">The Element Library of Spatial Displacement Theory</p>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">
          All 118 elements analyzed through SDT. Periodic table properties derived from first principles using pressure geometry.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-12">
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-4xl font-bold text-blue-600">118</div>
          <div class="text-sm text-slate-600 mt-2">Elements Analyzed</div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-4xl font-bold text-purple-600">94</div>
          <div class="text-sm text-slate-600 mt-2">With Complete Data</div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-4xl font-bold text-emerald-600">6</div>
          <div class="text-sm text-slate-600 mt-2">Element Categories</div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-4xl font-bold text-orange-600">137</div>
          <div class="text-sm text-slate-600 mt-2">k-value (Fine Structure)</div>
        </div>
      </div>

      <!-- NEW: 3D Gallery Banner -->
      <div class="bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl p-6 mb-12 shadow-lg">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="text-white">
            <h2 class="text-2xl font-bold mb-2">🔬 3D Nuclear Structure Gallery</h2>
            <p class="text-amber-100">
              Explore interactive visualizations of atomic nuclei — see how protons and neutrons 
              arrange into deuterons, alpha particles, and more complex structures.
            </p>
          </div>
          <a href="/atomicus/gallery" class="flex-shrink-0 px-6 py-3 bg-white text-orange-600 font-bold rounded-lg hover:bg-amber-50 transition-colors shadow-md">
            View 3D Gallery →
          </a>
        </div>
      </div>

      <!-- Introduction -->
      <div class="bg-white rounded-xl shadow-md p-8 mb-8 border-l-4 border-blue-500">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">What is ATOMICUS?</h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          ATOMICUS is a comprehensive database of all 118 elements, analyzed entirely from the principles of Spatial Displacement Theory. Rather than accepting periodic table properties as empirical facts, SDT derives them from first principles:
        </p>
        <ul class="space-y-2 text-slate-700">
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold">1.</span>
            <span><strong>Ionization energies</strong> follow from pressure field gradients at each orbital</span>
          </li>
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold">2.</span>
            <span><strong>Atomic radius</strong> is determined by the helix geometry of outer electrons</span>
          </li>
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold">3.</span>
            <span><strong>Electronegativity</strong> emerges from the strength of the nuclear pressure field</span>
          </li>
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold">4.</span>
            <span><strong>Chemical bonding</strong> is a consequence of occlusion geometry</span>
          </li>
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold">5.</span>
            <span><strong>Periodic patterns</strong> arise naturally from pressure field topology</span>
          </li>
        </ul>
      </div>

      <!-- Interactive periodic table -->
      <AtomicusPeriodicTable client:load />

      <!-- Element categories explanation -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
        <div class="bg-green-50 rounded-xl p-6 border-2 border-green-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
            Nonmetals
          </h3>
          <p class="text-slate-700 mb-2">
            Elements with high electronegativity and high ionization energies. Their pressure fields are tightly bound and strongly repulsive.
          </p>
          <p class="text-sm text-slate-600">Examples: H, C, N, O, F, S, Cl, Se</p>
        </div>

        <div class="bg-blue-50 rounded-xl p-6 border-2 border-blue-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-blue-500"></span>
            Alkali Metals
          </h3>
          <p class="text-slate-700 mb-2">
            Elements with low ionization energies and diffuse pressure fields. They readily lose their outer electron.
          </p>
          <p class="text-sm text-slate-600">Examples: Li, Na, K, Rb, Cs, Fr</p>
        </div>

        <div class="bg-purple-50 rounded-xl p-6 border-2 border-purple-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-purple-500"></span>
            Noble Gases
          </h3>
          <p class="text-slate-700 mb-2">
            Elements with complete outer shells. Their pressure fields are balanced and inert to additional perturbations.
          </p>
          <p class="text-sm text-slate-600">Examples: He, Ne, Ar, Kr, Xe, Rn</p>
        </div>

        <div class="bg-yellow-50 rounded-xl p-6 border-2 border-yellow-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
            Halogens
          </h3>
          <p class="text-slate-700 mb-2">
            Elements missing one electron from a complete shell. They have strong affinity for electrons.
          </p>
          <p class="text-sm text-slate-600">Examples: F, Cl, Br, I, At</p>
        </div>

        <div class="bg-red-50 rounded-xl p-6 border-2 border-red-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            Transition Metals
          </h3>
          <p class="text-slate-700 mb-2">
            Elements with partially filled d-orbitals. Their pressure fields have complex geometries and multiple bonding modes.
          </p>
          <p class="text-sm text-slate-600">Examples: Fe, Cu, Zn, Ag, Au, Pt</p>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border-2 border-slate-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-slate-500"></span>
            Post-transition & Rare Earth
          </h3>
          <p class="text-slate-700 mb-2">
            Elements with complex electron configurations. Their properties are determined by f-orbital and d-orbital interactions.
          </p>
          <p class="text-sm text-slate-600">Examples: Al, Ga, Sn, Pb, Lanthanides, Actinides</p>
        </div>
      </div>

      <!-- Key insights -->
      <div class="bg-gradient-to-r from-indigo-50 to-blue-50 rounded-xl p-8 mt-12 border-2 border-indigo-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Key Insights from ATOMICUS</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-bold text-slate-900 mb-2">The Fine Structure Constant</h3>
            <p class="text-slate-700 mb-2">
              All elements exhibit similar k-values (~137) in their orbital mechanics. This is not a coincidence—α = 1/137 emerges from the geometric relationship between pressure fields and orbital helices.
            </p>
            <p class="text-sm text-slate-600">
              This unifies atomic physics with the broader theory.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 mb-2">Occlusion and Periodicity</h3>
            <p class="text-slate-700 mb-2">
              Inner electrons occlude (shadow) the nuclear pressure field. This creates the periodic pattern: elements with the same number of outer electrons have similar chemical properties.
            </p>
            <p class="text-sm text-slate-600">
              The periodic table is a direct consequence of occlusion geometry.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 mb-2">Chemical Bonding from Geometry</h3>
            <p class="text-slate-700 mb-2">
              Ionic bonds form when pressure fields repel. Covalent bonds form when pressure fields overlap constructively. Metallic bonds form when pressure fields merge into a common field.
            </p>
            <p class="text-sm text-slate-600">
              All chemical bonding follows from pressure field topology.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 mb-2">Physical Properties Prediction</h3>
            <p class="text-slate-700 mb-2">
              Melting points, boiling points, density, and other bulk properties can be predicted from the atomic pressure geometry and how atoms pack together.
            </p>
            <p class="text-sm text-slate-600">
              From atoms to materials—all from first principles.
            </p>
          </div>
        </div>
      </div>

      <!-- Data accuracy -->
      <div class="bg-white rounded-xl shadow-md p-8 mt-8 border-l-4 border-emerald-500">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Data Accuracy</h2>
        <p class="text-slate-700 mb-4">
          ATOMICUS data is validated against:
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-slate-700">
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>NIST atomic spectroscopy database</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>CRC Handbook of Chemistry and Physics</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>Experimental ionization energies</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>Atomic radius measurements</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>Electronegativity scales (Pauling, Allred-Rochow)</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-600">✓</span>
            <span>Physical property databases</span>
          </li>
        </ul>
      </div>

      <!-- Download & resources -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
        <div class="bg-blue-50 rounded-xl p-6 border-2 border-blue-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Download Complete Data</h3>
          <p class="text-slate-700 mb-4">
            Access the full ATOMICUS database in multiple formats.
          </p>
          <a href="/downloads/atomicus-complete.csv" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors mb-2">
            CSV Export
          </a>
          <a href="/downloads/atomicus-complete.json" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors">
            JSON Export
          </a>
        </div>

        <div class="bg-purple-50 rounded-xl p-6 border-2 border-purple-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Learn More</h3>
          <p class="text-slate-700 mb-4">
            Explore the theoretical foundations of atomic structure.
          </p>
          <a href="/theory/atomic-physics" class="inline-block px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition-colors">
            Atomic Physics Theory
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex gap-4 justify-between mt-12 pt-8 border-t border-slate-200">
        <a href="/" class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-900 rounded-lg font-semibold transition-colors">
          ← Back to home
        </a>
        <a href="/papers" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors">
          Theory papers →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
