---
/**
 * Creative Agent: Flower of Life Walkthrough Page
 * 
 * TEKNE: The page IS the experience
 * 
 * Full-screen immersive 3D walkthrough with:
 * - Sacred geometry Flower of Life landing
 * - Three narrative paths (Quick Tour, Deep Dive, Scientific)
 * - Golden ratio animations throughout
 * - Fibonacci-distributed particle effects
 */
import FlowerOfLifeWalkthrough from '../../components/walkthrough/FlowerOfLifeWalkthrough';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Explore Spatial Displacement Theory through an immersive 3D experience with sacred geometry" />
    <title>SDT Interactive Experience | Spatial Displacement Theory</title>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="SDT Interactive Experience" />
    <meta property="og:description" content="Explore Spatial Displacement Theory through an immersive 3D experience" />
    <meta property="og:type" content="website" />
    
    <!-- Full-screen styling -->
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #0a0e1a;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      
      #app {
        width: 100vw;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
      }
      
      /* Golden ratio animation timing */
      :root {
        --phi: 1.618033988749895;
        --phi-inverse: 0.618033988749895;
        --duration-fast: calc(0.3s * var(--phi-inverse));
        --duration-normal: calc(0.5s * var(--phi));
        --duration-slow: calc(1s * var(--phi));
      }
      
      /* Custom scrollbar for content areas */
      ::-webkit-scrollbar {
        width: 8px;
      }
      
      ::-webkit-scrollbar-track {
        background: #1a365d;
      }
      
      ::-webkit-scrollbar-thumb {
        background: #d69e2e;
        border-radius: 4px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: #f6ad55;
      }
      
      /* Loading state before React hydrates */
      .loading-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #0a0e1a 0%, #1a365d 100%);
      }
      
      .loading-rings {
        width: 64px;
        height: 64px;
        border: 3px solid #1a365d;
        border-top-color: #d69e2e;
        border-radius: 50%;
        animation: spin 1.618s linear infinite;
      }
      
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div id="app">
      <!-- Loading placeholder (shown before React hydrates) -->
      <div class="loading-placeholder" id="loading">
        <div class="loading-rings"></div>
      </div>
      
      <!-- React component mounts here -->
      <FlowerOfLifeWalkthrough client:load />
    </div>
    
    <script>
      // Hide loading placeholder once React mounts
      document.addEventListener('DOMContentLoaded', () => {
        const loading = document.getElementById('loading');
        if (loading) {
          setTimeout(() => {
            loading.style.opacity = '0';
            loading.style.transition = 'opacity 0.618s ease-out';
            setTimeout(() => loading.remove(), 618);
          }, 100);
        }
      });
    </script>
  </body>
</html>

